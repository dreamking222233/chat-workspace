CHAT_DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/chat_workspace?charset=utf8mb4
CHAT_JWT_SECRET=replace-with-a-long-random-secret
CHAT_ENCRYPTION_KEY=replace-with-a-fernet-key
CHAT_ADMIN_EMAIL=admin@example.com
CHAT_ADMIN_PASSWORD=change-me-now
CHAT_CORS_ORIGINS=http://localhost:5173,http://localhost:4175,http://localhost:4176,http://localhost:4177,http://localhost:4178,http://localhost:4179,http://localhost:4180
CHAT_STORAGE_DIR=./data/assets
CHAT_MODEL_TIMEOUT_SECONDS=90
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_AUTH_REQUESTS=20
CHAT_RATE_LIMIT_MODEL_REQUESTS=30
CHAT_ASSET_CLEANUP_DAYS=30
# Optional first-boot channel seed. Keep secrets in deployment environment;
# administrators can add or edit additional providers from /admin/model-channels.
# channel_type: official (ChatGPT 官网反代，支持上游自带能力) or codex (Codex GPT 反代)
# CHAT_MODEL_CHANNELS_JSON=[{"name":"provider-text","base_url":"https://provider.example/v1","api_key":"TOKEN","channel_type":"official","modality":"text","models":["gpt-text"],"priority":10},{"name":"provider-codex","base_url":"https://codex.example/v1","api_key":"TOKEN","channel_type":"codex","modality":"both","models":["gpt-text","gpt-image-2"],"priority":20}]
CHAT_MODEL_TOOL_MAX_ROUNDS=2
CHAT_MODEL_TOOL_MAX_CALLS=4
CHAT_MODEL_MAX_REFERENCE_BYTES=33554432
CHAT_MODEL_MAX_IMAGE_BYTES=26214400
